From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rodrigo Goya <rodrigo.goya@abcellera.com>
Date: Sat, 14 Nov 2026 15:54:16 -0700
Subject: [PATCH 5/6] Keep DeprecationWarnings visible on Python 3.13

The 3.13 build skipped PySys_AddWarnOption(L"default") without a
replacement, so DeprecationWarnings raised outside __main__ were hidden.
Install the same filter with warnings.simplefilter('default') right
after Py_Initialize() on 3.13+.
---
 vmd/vmd_src/src/PythonTextInterp.C | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/vmd/vmd_src/src/PythonTextInterp.C b/vmd/vmd_src/src/PythonTextInterp.C
index 658e4bd..a4b93c4 100644
--- a/vmd/vmd_src/src/PythonTextInterp.C
+++ b/vmd/vmd_src/src/PythonTextInterp.C
@@ -161,7 +161,7 @@ PythonTextInterp::PythonTextInterp(VMDApp *vmdapp) : app(vmdapp) {
 #if PY_MAJOR_VERSION >= 3
   PyImport_AppendInittab("vmd", PyInit_vmd);
 #if PY_VERSION_HEX < 0x030D0000
-  // Removed in Python 3.13 (use PyConfig.warnoptions instead)
+  // Removed in Python 3.13; the filter is installed after Py_Initialize below
   PySys_AddWarnOption(L"default");
 #endif
 #else
@@ -171,6 +171,12 @@ PythonTextInterp::PythonTextInterp(VMDApp *vmdapp) : app(vmdapp) {
 
   Py_Initialize();
 
+#if PY_VERSION_HEX >= 0x030D0000
+  // Equivalent of -W default, since PySys_AddWarnOption is gone in 3.13
+  if (PyRun_SimpleString("import warnings; warnings.simplefilter('default')"))
+    msgWarn << "Could not enable Python DeprecationWarnings" << sendmsg;
+#endif
+
   // Some modules (like Tk) assume that os.argv has been initialized
 #if PY_MAJOR_VERSION >= 3
   PySys_SetArgv(app->argc_m-1, (wchar_t **)app->argv_m+1);
