From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rodrigo Goya <rodrigo.goya@abcellera.com>
Date: Fri, 13 Nov 2026 21:06:00 -0700
Subject: [PATCH 2/2] Fix build with Python 3.13

PyEval_CallObject and PySys_AddWarnOption were removed in Python 3.13.
PyObject_CallObject is the documented replacement and exists in all
supported versions. Skip PySys_AddWarnOption on 3.13+.

PySys_SetArgv is deprecated but only scheduled for removal in 3.16, so
it is left alone for now.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 vmd/vmd_src/src/PythonTextInterp.C | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/vmd/vmd_src/src/PythonTextInterp.C b/vmd/vmd_src/src/PythonTextInterp.C
index 36ef000..658e4bd 100644
--- a/vmd/vmd_src/src/PythonTextInterp.C
+++ b/vmd/vmd_src/src/PythonTextInterp.C
@@ -90,7 +90,7 @@ static void call_callbacks(const char *type, PyObject *arglist) {
 
   for (int i=0; i<PyList_GET_SIZE(cblist); i++) {
     PyObject *obj = PyList_GET_ITEM(cblist, i);
-    PyObject *result = PyEval_CallObject(obj, arglist);
+    PyObject *result = PyObject_CallObject(obj, arglist);
     if (result == NULL) {
       PyErr_Print();
       PySequence_DelItem(cblist, i);
@@ -160,7 +160,10 @@ PythonTextInterp::PythonTextInterp(VMDApp *vmdapp) : app(vmdapp) {
   // Do emit DeprecationWarnings
 #if PY_MAJOR_VERSION >= 3
   PyImport_AppendInittab("vmd", PyInit_vmd);
+#if PY_VERSION_HEX < 0x030D0000
+  // Removed in Python 3.13 (use PyConfig.warnoptions instead)
   PySys_AddWarnOption(L"default");
+#endif
 #else
   PyImport_AppendInittab("vmd", initvmd);
   PySys_AddWarnOption((char*) "default");
